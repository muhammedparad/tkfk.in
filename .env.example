# Environment Configuration Template for Gandhi Jayanti 2026 Knowledge Challenge (GKC26)
# DO NOT COMMIT SECRETS TO GIT

NODE_ENV=production

# Supabase Configuration (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_service_role_key_here

# Administrative & Session Authentication Secrets
ADMIN_SESSION_SECRET=your_admin_session_hmac_secret_here
PARTICIPANT_SESSION_SECRET=your_participant_session_hmac_secret_here

# Razorpay Payment Gateway Credentials (Server Only)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Public Contact & Support
NEXT_PUBLIC_SUPPORT_PHONE=+91 98765 43210
NEXT_PUBLIC_WHATSAPP_URL=https://chat.whatsapp.com/TKFK26OfficialGroup
